; Averages of two i32s without the widened addition: (a & b) + ((a ^ b) >> 1)
; and (a | b) - ((a ^ b) >> 1) rounding up, instead of 64-bit additions on the
; wide issue slot. Checked with agx-tv.

define agx_kernel void @flooru(ptr addrspace(1) %p, i32 %a, i32 %b) {
; CHECK-LABEL: flooru:
; CHECK:         // uniform registers: 14 x 16-bit (threadgroups_per_grid at u4)
; CHECK-NEXT:    // general purpose registers: 3 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    xor r1, u2, u3
; CHECK-NEXT:    and r2, u2, u3
; CHECK-NEXT:    bfeil r1, 0, r1, 1
; CHECK-NEXT:    iadd r1, r2, r1
; CHECK-NEXT:    device_store 0, i32, x, r1, u0_u1, 0, signed
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %x = zext i32 %a to i64
  %y = zext i32 %b to i64
  %s = add i64 %x, %y
  %h = lshr i64 %s, 1
  %r = trunc i64 %h to i32
  store i32 %r, ptr addrspace(1) %p
  ret void
}
