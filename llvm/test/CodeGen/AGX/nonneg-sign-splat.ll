; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=agx -mcpu=agx-g14c -O3 < %s | FileCheck %s

; l starts at a thread position and steps up by 256 without signed overflow:
; with the special register bounds it is never negative, so the corrections
; of l / 16 and l % 16 (l >> 31) are 0: a shift and a mask (L15-E158). The
; exit test l < 768 is of l + 256 < 1024, which cannot overflow, so l and
; l + 256 share a register (L15-E159). With the bounds given before
; AGXNarrowInductions, l is the stores' index register (no 64-bit pointers
; stepped beside it: 11 -> 6 GPRs, L15-E224).

declare i32 @llvm.agx.thread.position.in.threadgroup.x()

define agx_kernel void @tile(ptr addrspace(1) %p, ptr addrspace(1) %q) {
; CHECK-LABEL: tile:
; CHECK:         // uniform registers: 14 x 16-bit (threadgroups_per_grid at u4)
; CHECK-NEXT:    // general purpose registers: 6 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    mov_imm r0l, 0
; CHECK-NEXT:    get_sr r1, sr48 (thread_position_in_threadgroup.x)
; CHECK-NEXT:    mov_imm r3, 256
; CHECK-NEXT:    mov_imm r4, 1023
; CHECK-NEXT:    and r2, r1, 15
; CHECK-NEXT:    if_fcmp r0l, eq, 0.0, 0.0, 1
; CHECK-NEXT:  .LBB0_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    bfeil r5, 0, r1, 4
; CHECK-NEXT:    device_store 0, i32, x, r5, u0_u1, r1, unsigned
; CHECK-NEXT:    device_store 0, i32, x, r2, u2_u3, r1, unsigned
; CHECK-NEXT:    iadd r1, r1, r3
; CHECK-NEXT:    while_icmp r0l, slte, r1, r4, 1
; CHECK-NEXT:    jmp_exec_any .LBB0_1
; CHECK-NEXT:  // %bb.2: // %done
; CHECK-NEXT:    pop_exec r0l, 1
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
entry:
  %t = call i32 @llvm.agx.thread.position.in.threadgroup.x()
  br label %loop
loop:
  %l = phi i32 [ %t, %entry ], [ %l1, %loop ]
  %s = ashr i32 %l, 31
  %u = lshr i32 %s, 28
  %b = add nsw i32 %u, %l
  %r = ashr i32 %b, 4
  %m = and i32 %b, -16
  %c = sub i32 %l, %m
  %a = getelementptr i32, ptr addrspace(1) %p, i32 %l
  store i32 %r, ptr addrspace(1) %a
  %aq = getelementptr i32, ptr addrspace(1) %q, i32 %l
  store i32 %c, ptr addrspace(1) %aq
  %l1 = add nsw i32 %l, 256
  %k = icmp slt i32 %l, 768
  br i1 %k, label %loop, label %done
done:
  ret void
}
