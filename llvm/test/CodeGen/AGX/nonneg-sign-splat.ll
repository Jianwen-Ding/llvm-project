; RUN: llc -mtriple=agx -mcpu=agx-g14c -O3 < %s | FileCheck %s

; l starts at a thread position and steps up by 256 without signed overflow:
; with the special register bounds it is never negative, so the corrections
; of l / 16 and l % 16 (l >> 31) are 0: a shift and a mask.

declare i32 @llvm.agx.thread.position.in.threadgroup.x()

define agx_kernel void @tile(ptr addrspace(1) %p, ptr addrspace(1) %q) {
; CHECK-LABEL: tile:
; CHECK:         // uniform registers: 14 x 16-bit (threadgroups_per_grid at u4)
; CHECK-NEXT:    // general purpose registers: 11 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    mov_imm r0l, 0
; CHECK-NEXT:    get_sr r8, sr48 (thread_position_in_threadgroup.x)
; CHECK-NEXT:    bitop 0101, r2, u2, 0
; CHECK-NEXT:    bitop 0101, r3, u3, 0
; CHECK-NEXT:    bitop 0101, r4, u0, 0
; CHECK-NEXT:    bitop 0101, r5, u1, 0
; CHECK-NEXT:    iadd r2_r3, r2_r3, r8, lsl 2
; CHECK-NEXT:    iadd r4_r5, r4_r5, r8, lsl 2
; CHECK-NEXT:    mov_imm r1, 1024
; CHECK-NEXT:    mov_imm r6, 767
; CHECK-NEXT:    mov_imm r7, 256
; CHECK-NEXT:    if_fcmp r0l, eq, 0.0, 0.0, 1
; CHECK-NEXT:  .LBB0_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    bitop 0101, r9, r8, 0
; CHECK-NEXT:    asr r8, r8, 4
; CHECK-NEXT:    and r10, r9, 15
; CHECK-NEXT:    device_store 0, i32, x, r8, r4_r5, 0, signed
; CHECK-NEXT:    device_store 0, i32, x, r10, r2_r3, 0, signed
; CHECK-NEXT:    iadd r2_r3, r2_r3, r1
; CHECK-NEXT:    iadd r4_r5, r4_r5, r1
; CHECK-NEXT:    iadd r8, r9, r7
; CHECK-NEXT:    while_icmp r0l, slte, r9, r6, 1
; CHECK-NEXT:    jmp_exec_any .LBB0_1
; CHECK-NEXT:  // %bb.2: // %done
; CHECK-NEXT:    pop_exec r0l, 1
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
entry:
  %t = call i32 @llvm.agx.thread.position.in.threadgroup.x()
  br label %loop
loop:
  %l = phi i32 [ %t, %entry ], [ %l1, %loop ]
  %s = ashr i32 %l, 31
  %u = lshr i32 %s, 28
  %b = add nsw i32 %u, %l
  %r = ashr i32 %b, 4
  %m = and i32 %b, -16
  %c = sub i32 %l, %m
  %a = getelementptr i32, ptr addrspace(1) %p, i32 %l
  store i32 %r, ptr addrspace(1) %a
  %aq = getelementptr i32, ptr addrspace(1) %q, i32 %l
  store i32 %c, ptr addrspace(1) %aq
  %l1 = add nsw i32 %l, 256
  %k = icmp slt i32 %l, 768
  br i1 %k, label %loop, label %done
done:
  ret void
}
