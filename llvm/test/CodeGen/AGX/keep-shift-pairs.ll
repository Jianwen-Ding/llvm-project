define agx_kernel void @mask32(ptr addrspace(1) %p, i32 %x) {
; CHECK-LABEL: mask32:
; CHECK:         // uniform registers: 12 x 16-bit (threadgroups_per_grid at u3)
; CHECK-NEXT:    // general purpose registers: 2 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    mov_imm r1, -65536
; CHECK-NEXT:    and r1, u2, r1
; CHECK-NEXT:    device_store 0, i32, x, r1, u0_u1, 0, signed
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %s = lshr i32 %x, 16
  %m = shl i32 %s, 16
  store i32 %m, ptr addrspace(1) %p, align 4
  ret void
}
