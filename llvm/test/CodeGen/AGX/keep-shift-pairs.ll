; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=agx -mcpu=agx-g14c -O3 < %s | FileCheck %s

; A 64-bit (x >> a) << b stays a shift pair where the mask it would fold to,
; ((-1 >> a) << b), is beyond the 8-bit immediate: the shift left is the
; address's index shift ((i / 32) * 4 bytes: one bfeil and the index register,
; not a mask, a 64-bit add and the base copied to registers). A 32-bit pair is
; still folded (one mov_imm serves every and of the mask): mask32.

define agx_kernel void @div32(ptr addrspace(1) %p, i32 %x, float %v) {
; CHECK-LABEL: div32:
; CHECK:         // uniform registers: 14 x 16-bit (threadgroups_per_grid at u4)
; CHECK-NEXT:    // general purpose registers: 3 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    bfeil r1, 0, u2, 5
; CHECK-NEXT:    bitop 0101, r2, u3, 0
; CHECK-NEXT:    device_store 0, i32, x, r2, u0_u1, r1, unsigned
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %z = zext i32 %x to i64
  %g = lshr i64 %z, 5
  %a = getelementptr inbounds nuw [4 x i8], ptr addrspace(1) %p, i64 %g
  store float %v, ptr addrspace(1) %a, align 4
  ret void
}
