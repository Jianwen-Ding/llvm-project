; A thread reads its own value at its own index: a shuffle at
; select(c, lane ^ k, lane) is select(c, shuffle_xor(v, k), v), one shuffle
; where the divergent index took four (partial reductions' butterflies).

declare i32 @llvm.agx.thread.index.in.simdgroup()
declare i32 @llvm.agx.simd.shuffle.i32(i32, i32)

define agx_kernel void @butterfly(ptr addrspace(1) %p, i32 %n) {
; CHECK-LABEL: butterfly:
; CHECK:         // uniform registers: 12 x 16-bit (threadgroups_per_grid at u3)
; CHECK-NEXT:    // general purpose registers: 4 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    device_load 0, i32, x, r1, u0_u1, 0, signed
; CHECK-NEXT:    get_sr r2, sr52 (thread_index_in_simdgroup)
; CHECK-NEXT:    xor r2, r2, 2
; CHECK-NEXT:    wait 0
; CHECK-NEXT:    simd_shuffle_xor r3, r1, 2
; CHECK-NEXT:    icmpsel slt, r1, r2, u2, r3, r1
; CHECK-NEXT:    device_store 0, i32, x, r1, u0_u1, 0, signed
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %l = call i32 @llvm.agx.thread.index.in.simdgroup()
  %v = load i32, ptr addrspace(1) %p
  %x = xor i32 %l, 2
  %c = icmp slt i32 %x, %n
  %i = select i1 %c, i32 %x, i32 %l
  %m = and i32 %i, 65535
  %s = call i32 @llvm.agx.simd.shuffle.i32(i32 %v, i32 %m)
  store i32 %s, ptr addrspace(1) %p
  ret void
}

