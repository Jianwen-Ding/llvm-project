; CHECK-LABEL: count_lt:
; CHECK:         // uniform registers: 14 x 16-bit (threadgroups_per_grid at u4)
; CHECK-NEXT:    // general purpose registers: 2 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    icmp_ballot r1, ult, u2, u3
; CHECK-NEXT:    popcount r1, r1
; CHECK-NEXT:    device_store 0, i32, x, r1, u0_u1, 0, signed
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %c = icmp ult i32 %a, %b
  %m = call i32 @llvm.agx.simd.ballot(i1 %c)
  %r = call i32 @llvm.ctpop.i32(i32 %m)
  store i32 %r, ptr addrspace(1) %p
  ret void
}

