; An index modulo a power of two that MLIR computes in 64 bits, (zext(i) << 2)
; & 4092, is zext((i << 2) & 4092): 32-bit, and the load takes the base and
; the index. (i << s) & ((2^k - 1) << s) beyond the 8-bit immediates is one
; bfi of i's low k bits at offset s.

declare i32 @llvm.agx.thread.position.in.grid.x()

define agx_kernel void @bcast(ptr addrspace(1) %a, ptr addrspace(1) %b, ptr addrspace(1) %o) {
; CHECK-LABEL: bcast:
