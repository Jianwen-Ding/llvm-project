; CHECK-NEXT:    // general purpose registers: 4 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    get_sr r1, sr80 (thread_position_in_grid.x)
; CHECK-NEXT:    bfi r2, 0, r1, 2, mask 0x3FF
; CHECK-NEXT:    device_load 0, i32, x, r3, u0_u1, r1, unsigned, lsl 2
; CHECK-NEXT:    device_load 0, i32, x, r2, u2_u3, r2, unsigned
; CHECK-NEXT:    wait 0
; CHECK-NEXT:    fadd32 r2, r3, r2
; CHECK-NEXT:    device_store 0, i32, x, r2, u4_u5, r1, unsigned, lsl 2
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %t = call i32 @llvm.agx.thread.position.in.grid.x()
  %z = zext i32 %t to i64
  %i = shl nuw nsw i64 %z, 2
  %m = and i64 %i, 4092
  %pa = getelementptr float, ptr addrspace(1) %a, i64 %i
  %pb = getelementptr float, ptr addrspace(1) %b, i64 %m
  %x = load float, ptr addrspace(1) %pa
  %y = load float, ptr addrspace(1) %pb
  %s = fadd float %x, %y
  %po = getelementptr float, ptr addrspace(1) %o, i64 %i
  store float %s, ptr addrspace(1) %po
  ret void
}

