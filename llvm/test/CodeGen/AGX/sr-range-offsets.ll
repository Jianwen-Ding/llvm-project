; A threadgroup has at most 1024 threads: zext(tid + 256) is zext(tid) + 256,
; so the loads at tid + 256k take one address and immediate offsets.

declare i32 @llvm.agx.thread.position.in.threadgroup.x()

define agx_kernel void @rows(ptr addrspace(1) %p, ptr addrspace(1) %q) {
; CHECK-LABEL: rows:
; CHECK:         // uniform registers: 14 x 16-bit (threadgroups_per_grid at u4)
; CHECK-NEXT:    // general purpose registers: 6 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    get_sr r1, sr48 (thread_position_in_threadgroup.x)
; CHECK-NEXT:    bitop 0101, r2, u0, 0
; CHECK-NEXT:    bitop 0101, r3, u1, 0
; CHECK-NEXT:    device_load 0, i32, x, r4, u0_u1, r1, unsigned
; CHECK-NEXT:    iadd r2_r3, r2_r3, r1, lsl 2
; CHECK-NEXT:    device_load 0, i32, x, r5, r2_r3, 256, signed
; CHECK-NEXT:    device_load 1, i32, x, r2, r2_r3, 512, signed
; CHECK-NEXT:    wait 0
; CHECK-NEXT:    fadd32 r3, r4, r5
; CHECK-NEXT:    wait 1
; CHECK-NEXT:    fadd32 r2, r3, r2
; CHECK-NEXT:    device_store 0, i32, x, r2, u2_u3, r1, unsigned
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %t = call i32 @llvm.agx.thread.position.in.threadgroup.x()
  %e0 = zext i32 %t to i64
  %a0 = getelementptr inbounds nuw [4 x i8], ptr addrspace(1) %p, i64 %e0
  %v0 = load float, ptr addrspace(1) %a0, align 4
  %t1 = add i32 %t, 256
  %e1 = zext i32 %t1 to i64
  %a1 = getelementptr inbounds nuw [4 x i8], ptr addrspace(1) %p, i64 %e1
  %v1 = load float, ptr addrspace(1) %a1, align 4
  %t2 = add i32 %t, 512
  %e2 = zext i32 %t2 to i64
  %a2 = getelementptr inbounds nuw [4 x i8], ptr addrspace(1) %p, i64 %e2
  %v2 = load float, ptr addrspace(1) %a2, align 4
  %s0 = fadd float %v0, %v1
  %s1 = fadd float %s0, %v2
  %b = getelementptr inbounds nuw [4 x i8], ptr addrspace(1) %q, i64 %e0
  store float %s1, ptr addrspace(1) %b, align 4
