; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=agx -mcpu=agx-g14c -O3 < %s | FileCheck %s

; A select on the or / and of two compares that legalization makes (one and
; ueq float compares) is two nested compare-selects, not a truth value, a
; second compare selecting it and a select on the result. Checked with
; agx-tv.

define agx_kernel void @one(ptr addrspace(1) %p, float %a, float %b, float %x, float %y) {
; CHECK-LABEL: one:
; CHECK:         // uniform registers: 18 x 16-bit (threadgroups_per_grid at u6)
; CHECK-NEXT:    // general purpose registers: 2 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    fcmpsel lt, r1, u2, u3, u4, u5
; CHECK-NEXT:    fcmpsel gt, r1, u2, u3, u4, r1
; CHECK-NEXT:    device_store 0, i32, x, r1, u0_u1, 0, signed
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %c = fcmp one float %a, %b
  %r = select i1 %c, float %x, float %y
  store float %r, ptr addrspace(1) %p
  ret void
}
define agx_kernel void @ueq(ptr addrspace(1) %p, float %a, float %b, float %x, float %y) {
; CHECK-LABEL: ueq:
; CHECK:         // uniform registers: 18 x 16-bit (threadgroups_per_grid at u6)
; CHECK-NEXT:    // general purpose registers: 2 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    fcmpsel lt, r1, u2, u3, u5, u4
; CHECK-NEXT:    fcmpsel gt, r1, u2, u3, u5, r1
; CHECK-NEXT:    device_store 0, i32, x, r1, u0_u1, 0, signed
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %c = fcmp ueq float %a, %b
  %r = select i1 %c, float %x, float %y
  store float %r, ptr addrspace(1) %p
  ret void
}
