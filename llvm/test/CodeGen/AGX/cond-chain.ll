; CHECK-NEXT:    icmpsel ueq, r3, r6, 0, r3, r5
; CHECK-NEXT:    icmpsel ueq, r2, r6, 0, r2, r4
; CHECK-NEXT:    device_store 0, i32, x, r3, u0_u1, r1, signed
; CHECK-NEXT:    device_store 0, i32, x, r2, u2_u3, r1, signed
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
