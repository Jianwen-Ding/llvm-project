; CHECK-NEXT:    trap
entry:
  %t = call i32 @llvm.agx.thread.position.in.grid.x()
  %pv = getelementptr float, ptr addrspace(1) %v, i32 %t
  %pi = getelementptr i32, ptr addrspace(1) %ix, i32 %t
  %a = load float, ptr addrspace(1) %pv, align 4
  %i = load i32, ptr addrspace(1) %pi, align 4
  %ab = bitcast float %a to i32
  %ob = call i32 @llvm.agx.simd.shuffle.xor.i32(i32 %ab, i32 1)
  %o = bitcast i32 %ob to float
  %oi = call i32 @llvm.agx.simd.shuffle.xor.i32(i32 %i, i32 1)
  %gt = fcmp olt float %a, %o
  br i1 %gt, label %take, label %tie
tie:
  %eq = fcmp oeq float %a, %o
  %lt = icmp slt i32 %oi, %i
  %c = and i1 %eq, %lt
  br i1 %c, label %take, label %join
take:
  br label %join
join:
  %rv = phi float [ %o, %take ], [ %a, %tie ]
  %ri = phi i32 [ %oi, %take ], [ %i, %tie ]
  store float %rv, ptr addrspace(1) %pv, align 4
  store i32 %ri, ptr addrspace(1) %pi, align 4
  ret void
}
