; RUN: llc -mtriple=agx -mcpu=agx-g14c -O3 < %s | FileCheck %s

; A loop's address computed in 64-bit integers, ((row + sext(i)) << 2) + base,
; is (base + (row << 2)) + (sext(i) << 2): the sum goes before the loop and
; the load takes it and the 32-bit index.

define agx_kernel void @rowsum(ptr addrspace(1) %p, ptr addrspace(1) %q, i64 %row, i32 %n, i32 %s) {
; CHECK-LABEL: rowsum:
; CHECK:         // uniform registers: 22 x 16-bit (threadgroups_per_grid at u8)
; CHECK-NEXT:    // general purpose registers: 6 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    mov_imm r0l, 0
; CHECK-NEXT:    bitop 0101, r2, u4, 0
; CHECK-NEXT:    bitop 0101, r3, u5, 0
; CHECK-NEXT:    bitop 0101, r4, u0, 0
; CHECK-NEXT:    bitop 0101, r5, u1, 0
; CHECK-NEXT:    mov_imm r1, 0
; CHECK-NEXT:    iadd r2_r3, r4_r5, r2_r3, lsl 2
; CHECK-NEXT:    mov_imm r4, 0
; CHECK-NEXT:    if_fcmp r0l, eq, 0.0, 0.0, 1
; CHECK-NEXT:  .LBB0_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    device_load 0, i32, x, r5, r2_r3, r4, signed
; CHECK-NEXT:    iadd r4, r4, u7
; CHECK-NEXT:    wait 0
; CHECK-NEXT:    fadd32 r1, r1, r5
; CHECK-NEXT:    while_icmp r0l, slt, r4, u6, 1
; CHECK-NEXT:    jmp_exec_any .LBB0_1
; CHECK-NEXT:  // %bb.2: // %done
; CHECK-NEXT:    pop_exec r0l, 1
; CHECK-NEXT:    device_store 0, i32, x, r1, u2_u3, 0, signed
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
entry:
  %base = ptrtoint ptr addrspace(1) %p to i64
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %acc = phi float [ 0.0, %entry ], [ %acc1, %loop ]
  %e = sext i32 %i to i64
  %o = add nsw i64 %row, %e
  %b = shl i64 %o, 2
  %a = add i64 %b, %base
  %pa = inttoptr i64 %a to ptr addrspace(1)
  %v = load float, ptr addrspace(1) %pa, align 4
  %acc1 = fadd float %acc, %v
  %i1 = add i32 %i, %s
  %c = icmp slt i32 %i1, %n
  br i1 %c, label %loop, label %done
done:
  store float %acc1, ptr addrspace(1) %q
  ret void
}
