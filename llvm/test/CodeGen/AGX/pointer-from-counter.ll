; RUN: llc -mtriple=agx -mcpu=agx-g14c -O3 < %s | FileCheck %s

; (MLIR's two_index, lowered.) LSR walks %0 at stride 8 bytes with a pointer
; induction next to the 32-bit counter j that %1's load takes as its index.
; The pointer is a + 8 j: its load takes j with the index shift (lsl 1), and
; its 64-bit add goes.

target triple = "agx"

define agx_kernel void @two_index(ptr addrspace(1) nofree readonly captures(none) %0, ptr addrspace(1) nofree readonly captures(none) %1, ptr addrspace(1) nofree writeonly captures(none) %2) local_unnamed_addr {
; CHECK-LABEL: two_index:
; CHECK:         // uniform registers: 18 x 16-bit (threadgroups_per_grid at u6)
; CHECK-NEXT:    // general purpose registers: 10 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    mov_imm r0l, 0
; CHECK-NEXT:    get_sr r1, sr80 (thread_position_in_grid.x)
; CHECK-NEXT:    bitop 0101, r6, u2, 0
; CHECK-NEXT:    bitop 0101, r7, u3, 0
; CHECK-NEXT:    bfi r4, 0, r1, 8
; CHECK-NEXT:    bitop 0101, r2, u0, 0
; CHECK-NEXT:    bitop 0101, r3, u1, 0
; CHECK-NEXT:    iadd r6_r7, r6_r7, r4, lsl 2
; CHECK-NEXT:    iadd r2_r3, r2_r3, r4, lsl 2
; CHECK-NEXT:    mov_imm r4, 0
; CHECK-NEXT:    mov_imm r5, 0
; CHECK-NEXT:    if_fcmp r0l, eq, 0.0, 0.0, 1
; CHECK-NEXT:  .LBB0_1: // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    device_load 0, i32, x, r8, r2_r3, r5, unsigned, lsl 1
; CHECK-NEXT:    device_load 0, i32, x, r9, r6_r7, r5, unsigned
; CHECK-NEXT:    iadd r5, r5, 1
; CHECK-NEXT:    wait 0
; CHECK-NEXT:    fmadd32 r4, r8, r9, r4
; CHECK-NEXT:    while_icmp r0l, nueq, r5, 128, 1
; CHECK-NEXT:    jmp_exec_any .LBB0_1
; CHECK-NEXT:  // %bb.2:
; CHECK-NEXT:    pop_exec r0l, 1
; CHECK-NEXT:    device_store 0, i32, x, r4, u4_u5, r1, unsigned
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
entry:
  %3 = tail call i32 @llvm.agx.thread.position.in.grid.x()
  %4 = shl i32 %3, 8
  %5 = zext i32 %4 to i64
  %invariant.gep = getelementptr inbounds nuw [4 x i8], ptr addrspace(1) %0, i64 %5
  %invariant.gep1 = getelementptr inbounds nuw [4 x i8], ptr addrspace(1) %1, i64 %5
  br label %6

6:                                                ; preds = %entry, %6
  %indvars.iv = phi i64 [ 0, %entry ], [ %indvars.iv.next, %6 ]
  %7 = phi float [ 0.000000e+00, %entry ], [ %10, %6 ]
  %.idx = shl nuw nsw i64 %indvars.iv, 3
  %gep = getelementptr inbounds nuw i8, ptr addrspace(1) %invariant.gep, i64 %.idx
  %8 = load float, ptr addrspace(1) %gep, align 4
  %gep2 = getelementptr inbounds nuw [4 x i8], ptr addrspace(1) %invariant.gep1, i64 %indvars.iv
  %9 = load float, ptr addrspace(1) %gep2, align 4
  %10 = tail call float @llvm.fma.f32(float %8, float %9, float %7)
  %indvars.iv.next = add nuw nsw i64 %indvars.iv, 1
  %exitcond.not = icmp eq i64 %indvars.iv.next, 128
  br i1 %exitcond.not, label %11, label %6

11:                                               ; preds = %6
  %12 = zext i32 %3 to i64
  %13 = getelementptr inbounds nuw [4 x i8], ptr addrspace(1) %2, i64 %12
  store float %10, ptr addrspace(1) %13, align 4
  ret void
}

declare noundef i32 @llvm.agx.thread.position.in.grid.x()

declare float @llvm.fma.f32(float, float, float)



