entry:
  %.val = load i32, ptr addrspace(4) %2, align 4
  %3 = tail call i32 @llvm.agx.thread.position.in.grid.x()
  %4 = zext i32 %3 to i64
  %5 = sext i32 %.val to i64
  %6 = icmp sgt i64 %5, %4
  %7 = sub nsw i64 %5, %4
  %8 = tail call i64 @llvm.umin.i64(i64 %7, i64 65536)
