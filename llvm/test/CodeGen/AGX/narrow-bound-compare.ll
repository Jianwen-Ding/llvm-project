; CHECK-NEXT:    isub r2_r3, r2_r3, r1
; CHECK-NEXT:    mov_imm r4, 65536
; CHECK-NEXT:    if_fcmp r0l, eq, 0.0, 0.0, 1
; CHECK-NEXT:    icmpsel ult, r5, r2, r4, 1, 0
; CHECK-NEXT:    icmpsel ueq, r3, r3, 0, r5, 0
; CHECK-NEXT:    icmpsel ueq, r2, r3, 0, r4, r2
