; CHECK-NEXT:    and r4, r4h, 255
; CHECK-NEXT:    asr r2, r2, 24
; CHECK-NEXT:    asr r3, r3, 24
; CHECK-NEXT:    isub r5, r5, 128
; CHECK-NEXT:    isub r4, r4, 128
; CHECK-NEXT:    imadd r2, r2, r3, 0
