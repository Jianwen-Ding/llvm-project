; One signed byte of a word keeps its own xor.
define agx_kernel void @one_byte(ptr addrspace(1) %p, i32 %w) {
; CHECK-LABEL: one_byte:
; CHECK:         // uniform registers: 12 x 16-bit (threadgroups_per_grid at u3)
; CHECK-NEXT:    // general purpose registers: 2 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    bfeil r1, 0, u2, 8, mask 0xFF
; CHECK-NEXT:    xor r1, r1, 128
; CHECK-NEXT:    isub r1, r1, 128
; CHECK-NEXT:    device_store 0, i32, x, r1, u0_u1, 0, signed
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
