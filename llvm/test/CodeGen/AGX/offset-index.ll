; CHECK-NEXT:    // general purpose registers: 4 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    get_sr r1, sr80 (thread_position_in_grid.x)
; CHECK-NEXT:    iadd r2, 1, r1, lsl 1
; CHECK-NEXT:    device_load 0, i16, x, r3h, u0_u1, r1, unsigned, lsl 1
; CHECK-NEXT:    device_load 1, i16, x, r3l, u0_u1, r2, unsigned
; CHECK-NEXT:    wait 0
; CHECK-NEXT:    device_store 0, i16, x, r3h, u2_u3, r1, unsigned, lsl 1
; CHECK-NEXT:    wait 1
; CHECK-NEXT:    device_store 0, i16, x, r3l, u2_u3, r2, unsigned
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %i = call i32 @llvm.agx.thread.position.in.grid.x()
  %z = zext i32 %i to i64
  %j = shl nuw nsw i64 %z, 1
  %p = getelementptr [2 x i8], ptr addrspace(1) %a, i64 %j
  %v = load <2 x half>, ptr addrspace(1) %p, align 2
  %q = getelementptr [2 x i8], ptr addrspace(1) %o, i64 %j
  store <2 x half> %v, ptr addrspace(1) %q, align 2
  ret void
}

