; The second half of a split <2 x half> access at base + 4 i + 2 is the index
; register 2 i + 1 (one iadd; a disjoint or of a shifted value is the shifted
; iadd) where i is known below 2^31: here by the kernel's known grid
; (agx-threads-per-grid). Without the bound, 2 i + 1 could wrap: the 64-bit
; base + 4 i with an immediate (half2_unknown).

declare i32 @llvm.agx.thread.position.in.grid.x()

define agx_kernel void @half2(ptr addrspace(1) %a, ptr addrspace(1) %o) #0 {
; CHECK-LABEL: half2:
