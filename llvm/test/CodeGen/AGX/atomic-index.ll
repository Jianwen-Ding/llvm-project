; A device atomic at base + 4 * zext(i) takes the base and the unsigned index
; register, as the hardware recording shows (atomic add, 0, r14, u8_u9, r5,
; unsigned, r6): no 64-bit add, and a uniform base stays uniform.

define agx_kernel void @add(ptr addrspace(1) %p, i32 %i, i32 %v) {
; CHECK-LABEL: add:
; CHECK:         // uniform registers: 14 x 16-bit (threadgroups_per_grid at u4)
; CHECK-NEXT:    // general purpose registers: 3 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    bitop 0101, r1, u3, 0
; CHECK-NEXT:    bitop 0101, r2, u2, 0
; CHECK-NEXT:    atomic add, 0, _, u0_u1, r2, unsigned, r1, 0
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %e = zext i32 %i to i64
  %a = getelementptr i32, ptr addrspace(1) %p, i64 %e
  %o = atomicrmw add ptr addrspace(1) %a, i32 %v monotonic
  ret void
}

