; A float clamped above at an 8-bit integer's maximum (or more) and converted
; to it is the saturating conversion of the value clamped below only (the
; convert saturates; the conversion above the maximum was poison): int8
; quantization keeps its lower bound, a fcmpsel, and the 8-bit convert, which
; also takes round's truncation; the byte store reads the byte, unextended.
; An unsigned conversion's lower bound at 0 or below goes too (a NaN gives 0
; either way): x * 255 clamped to [0, 255] is the product and the convert.

declare i32 @llvm.agx.thread.position.in.grid.x()

define agx_kernel void @quant(ptr addrspace(1) %p, ptr addrspace(1) %o) {
; CHECK-LABEL: quant:
; CHECK:         // uniform registers: 14 x 16-bit (threadgroups_per_grid at u4)
; CHECK-NEXT:    // general purpose registers: 4 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    get_sr r1, sr80 (thread_position_in_grid.x)
; CHECK-NEXT:    mov_imm r3, -1023541248
; CHECK-NEXT:    device_load 0, i32, x, r2, u0_u1, r1, signed
; CHECK-NEXT:    wait 0
; CHECK-NEXT:    fcmpsel gtn, r2, r2, r3, r2, r3
; CHECK-NEXT:    mov_imm r3, 1056964607
; CHECK-NEXT:    bfi r3, r2, r3, 0, mask 0x7FFFFFFF
; CHECK-NEXT:    fadd32 r2, r2, r3
; CHECK-NEXT:    convert s8_to_f, r2l, r2, rtz
; CHECK-NEXT:    device_store 0, i8, x, r2l, u2_u3, r1, signed
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %t = call i32 @llvm.agx.thread.position.in.grid.x()
  %q = getelementptr float, ptr addrspace(1) %p, i32 %t
  %x = load float, ptr addrspace(1) %q
  %r = call float @llvm.round.f32(float %x)
  %l = call float @llvm.maxnum.f32(float %r, float -127.0)
  %h = call float @llvm.minnum.f32(float %l, float 127.0)
  %c = fptosi float %h to i8
  %qo = getelementptr i8, ptr addrspace(1) %o, i32 %t
  store i8 %c, ptr addrspace(1) %qo
  ret void
}

