; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    imsub r1, u2, u3, u4
; CHECK-NEXT:    device_store 0, i32, x, r1, u0_u1, 0, signed
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %m = mul i32 %a, %b
  %s = sub i32 %m, %c
  store i32 %s, ptr addrspace(1) %p
  ret void
}
