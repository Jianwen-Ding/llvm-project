; CHECK-NEXT:    xor r5, r1, 4
; CHECK-NEXT:    icmpsel ueq, r4, r2, 2, r7, r4
; CHECK-NEXT:    icmpsel ueq, r2, r2, 3, r3, r4
; CHECK-NEXT:    and r3, r5, 28
