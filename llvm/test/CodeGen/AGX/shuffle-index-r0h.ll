; CHECK-NEXT:    bitop 0101, r0h, r3l, 0
; CHECK-NEXT:    simd_shuffle r4, r2, r0h
; CHECK-NEXT:    or r0h, r3l, 1
; CHECK-NEXT:    simd_shuffle r6, r2, r0h
; CHECK-NEXT:    or r0h, r3l, 2
; CHECK-NEXT:    simd_shuffle r7, r2, r0h
; CHECK-NEXT:    or r0h, r3l, 3
