; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    mov_imm r0h, 0
; CHECK-NEXT:    get_sr r1, sr52 (thread_index_in_simdgroup)
; CHECK-NEXT:    xor r2, r1, 5
; CHECK-NEXT:    iadd r3, u2, r1
; CHECK-NEXT:    and r4, r2, 28
; CHECK-NEXT:    and r2, r2, 3
; CHECK-NEXT:    bitop 0101, r0h, r4l, 0
; CHECK-NEXT:    simd_shuffle r5, r3, r0h
