; RUN: llc -mtriple=agx -mcpu=agx-g14c -verify-machineinstrs < %s | FileCheck %s

; A shuffle reads its lane index in r0h. An index computed by an addition or a
; bit operation shortly before the shuffle, and dead after it, is computed
; straight into r0h (its 16-bit form, right before the shuffle), not into a
; register and then moved; an index read again later keeps the move.

declare i32 @llvm.agx.thread.index.in.simdgroup()
declare i32 @llvm.agx.simd.shuffle.i32(i32, i32)

