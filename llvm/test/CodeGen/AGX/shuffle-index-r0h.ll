; CHECK-NEXT:    trap
  %lane = call i32 @llvm.agx.thread.index.in.simdgroup()
  %v = add i32 %x, %lane
  %i = xor i32 %lane, 5
  %j = xor i32 %lane, 4
  %a = call i32 @llvm.agx.simd.shuffle.i32(i32 %v, i32 %i)
  %b = call i32 @llvm.agx.simd.shuffle.i32(i32 %a, i32 %j)
